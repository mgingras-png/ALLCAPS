# Theme: ALLCAPS
# Version 1.0
# Last Update: 08/17/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# Description: All capital letters for the font and large text size for the title and artist. I merged the fonts Home Video by GGBOTNET and LanaPixel by eishiya using FontForge. Other than that, pretty simple theme! Code is based on my previous themes, specifically bunnyPod and minimal_RTCsync. All icons created by me.

## WPS File ##

#Hide The Status Bar
%wd

# Preload Fonts
%Fl(6,07-HomeVideo-CJK.fnt)
%Fl(7,14-HomeVideo-CJK.fnt)
%Fl(8,21-HomeVideo-CJK.fnt)
%Fl(9,28-HomeVideo-CJK.fnt)

# Preload Images
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(PB,pb.bmp,0,0)
%xl(PBB,pb_back.bmp,0,0)
%xl(VB,vb.bmp,0,0)
%xl(VBB,vb_back.bmp,0,0)
%xl(no_album,no_album.bmp,1,1)
%xl(disk,disk.bmp,0,0,5)
%xl(PS,ps.bmp,0,0)

## Main Display ##
%Vd(mainDisplay)

# Clear Screen
%Vl(mainDisplay,0,0,320,240,-)

# Hold
%Vl(mainDisplay,197,5,70,22,7)
%ac%?mh<HOLD%Vs(invert)|>

# Time
%Vl(mainDisplay,92,5,100,22,7)
%ac%?cf<%cH|%cl>:%cM%?cf<| %cP>%Vs(invert)

# Battery Icon
%Vl(mainDisplay,270,5,22,18,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Disk
%Vl(mainDisplay,296,5,19,17,-)
%?lh<%t(0.1)%xd(disk,5);%t(0.1)%xd(disk,1);%t(0.1)%xd(disk,2);%t(0.1)%xd(disk,3);%t(0.1)%xd(disk,4)|%xd(disk,5)>

# Playlist Number
%Vl(mainDisplay,205,33,110,22,7)
%ar%pp/%pe

# Play/Pause Icons
%Vl(mainDisplay,92,31,25,22,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|>

# Shuffle Icon
%Vl(mainDisplay,123,31,27,22,-)
%?ps<%xd(shuffle,1)|%xd(shuffle,2)>

# Repeat Icon
%Vl(mainDisplay,160,31,27,22,-)
%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>

# Volume Bar
%Vl(mainDisplay,92,68,160,19,-)
%pv(0,0,160,19,VBB,backdrop,VB)

# Volume Text
%Vl(mainDisplay,91,58,70,10,6)
%al%?if(%pv, =, -90)<MUTE|VOLUME>
%Vl(mainDisplay,257,68,58,22,7)
%ac%?if(%pv, >, 0)<+|>%pvdB

# Time Elapsed
%Vl(mainDisplay,5,223,40,10,6)
%ac%pc%Vs(invert)

# Track Progress Bar
%Vl(mainDisplay,50,220,220,15,-)%Vf(-)%Vb(-)
%pb(0,0,-,15,PBB,backdrop,PB,slider,PS)

# Time Remaining
%Vl(mainDisplay,275,223,40,10,6)
%ac-%pr%Vs(invert)

# Play Screen Album Art
%Vl(mainDisplay,5,5,82,82,-)
%Cl(1,1,80,80,c,c)
%?C<%Cd|%xd(no_album)>
%dr(0,0,82,1)
%dr(0,81,82,1)
%dr(0,1,1,80)
%dr(81,1,1,80)

# Track Title
%Vl(mainDisplay,5,98,310,38,9)
%al%s%?it<%s%it|%fn>

# Artist
%Vl(mainDisplay,5,137,310,26,8)
%al%s%?ia<%ia>

# Album
%Vl(mainDisplay,5,168,310,22,7)
%al%s%?id<%id>

# File Info
%Vl(mainDisplay,5,190,310,10,6)
%al%?it<%?iy<%ss(0,4,%iy)|>|> | %fc | %fb kbps | %fk kHz